{
  "name": "SniperXjohn Aizome",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "enumMember": "#8fd1b5",
    "variable.constant": "#e0a96d",
    "variable.readonly": "#e0a96d",
    "variable.defaultLibrary": "#e6cf7e",
    "parameter": { "foreground": "#e8b99a", "italic": true },
    "namespace": "#e6cf7e",
    "class": "#e6cf7e",
    "interface": "#e6cf7e",
    "type": "#e6cf7e",
    "typeParameter": "#e6cf7e",
    "enum": "#e6cf7e",
    "function": "#78bfc4",
    "method": "#78bfc4",
    "property": "#a8b8cc",
    "decorator": "#8fd1b5",
    "macro": "#8fd1b5",
    "keyword": "#a998d1",
    "comment": { "foreground": "#5d6a80", "italic": true }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5d6a80", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.object-literal.key", "variable.other.readwrite", "support.variable"],
      "settings": { "foreground": "#d4d0c2" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.property.object", "support.type.property-name"],
      "settings": { "foreground": "#a8b8cc" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "variable.parameter.function"],
      "settings": { "foreground": "#e8b99a", "fontStyle": "italic" }
    },
    {
      "name": "this / self / super",
      "scope": ["variable.language", "variable.parameter.function.language.special.self.python", "variable.language.rust", "variable.language.super"],
      "settings": { "foreground": "#e59aa8", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"],
      "settings": { "foreground": "#a998d1" }
    },
    {
      "name": "Import and flow keywords",
      "scope": ["keyword.control.import", "keyword.control.from", "keyword.control.flow", "keyword.control.import.python", "keyword.control.flow.python"],
      "settings": { "foreground": "#a998d1", "fontStyle": "italic" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.arithmetic", "keyword.operator.comparison", "keyword.operator.relational", "keyword.operator.assignment", "keyword.operator.logical", "keyword.operator.bitwise"],
      "settings": { "foreground": "#7f9fbf" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.brace.square", "punctuation.separator", "punctuation.terminator", "punctuation.section", "punctuation.definition.parameters", "punctuation.definition.arguments"],
      "settings": { "foreground": "#6c7a92" }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "meta.function-call.generic", "variable.function", "support.function.any-method", "meta.require", "keyword.other.special-method"],
      "settings": { "foreground": "#78bfc4" }
    },
    {
      "name": "Types, classes, namespaces",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.name.type.class", "entity.name.type.module", "entity.other.inherited-class", "support.class", "support.type", "support.type.primitive", "support.type.builtin", "storage.type.java", "storage.type.cs", "entity.name.package.go"],
      "settings": { "foreground": "#e6cf7e" }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string", "string.quoted", "markup.inline.raw"],
      "settings": { "foreground": "#a8c986" }
    },
    {
      "name": "Interpolation punctuation",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded", "keyword.other.substitution", "variable.interpolation"],
      "settings": { "foreground": "#a998d1" }
    },
    {
      "name": "Escapes and regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.character-class.regexp", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#8fd1b5" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant", "constant.numeric", "constant.language", "constant.other", "support.constant", "variable.other.constant", "constant.character"],
      "settings": { "foreground": "#e0a96d" }
    },
    {
      "name": "Symbols",
      "scope": ["constant.other.symbol", "constant.language.symbol", "constant.keyword.clojure"],
      "settings": { "foreground": "#8fd1b5" }
    },
    {
      "name": "Decorators and annotations",
      "scope": ["meta.decorator", "meta.function.decorator", "punctuation.decorator", "storage.type.annotation", "meta.annotation", "support.token.decorator.python"],
      "settings": { "foreground": "#8fd1b5" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": { "foreground": "#e59aa8" }
    },
    {
      "name": "Tag punctuation",
      "scope": ["punctuation.definition.tag", "meta.tag"],
      "settings": { "foreground": "#6c7a92" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class.css"],
      "settings": { "foreground": "#e0a96d" }
    },
    {
      "name": "Attribute ids",
      "scope": ["entity.other.attribute-name.id"],
      "settings": { "foreground": "#78bfc4" }
    },
    {
      "name": "CSS property names",
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name.css", "meta.property-name.css"],
      "settings": { "foreground": "#a8b8cc" }
    },
    {
      "name": "CSS values and units",
      "scope": ["support.constant.property-value.css", "support.constant.color", "constant.other.color", "keyword.other.unit"],
      "settings": { "foreground": "#e0a96d" }
    },
    {
      "name": "CSS pseudo selectors",
      "scope": ["entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element", "meta.selector"],
      "settings": { "foreground": "#a998d1" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json", "source.json meta.structure.dictionary.json > string.quoted.json"],
      "settings": { "foreground": "#78bfc4" }
    },
    {
      "name": "JSON string values",
      "scope": ["source.json meta.structure.dictionary.json > value.json > string.quoted.json", "source.json meta.structure.array.json > value.json > string.quoted.json"],
      "settings": { "foreground": "#a8c986" }
    },
    {
      "name": "YAML keys",
      "scope": ["entity.name.tag.yaml", "punctuation.definition.block.sequence.item.yaml"],
      "settings": { "foreground": "#78bfc4" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown", "markup.heading.setext"],
      "settings": { "foreground": "#e0a96d", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": { "foreground": "#e6cf7e", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": { "foreground": "#a998d1", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link.title.markdown", "string.other.link.description.markdown"],
      "settings": { "foreground": "#78bfc4" }
    },
    {
      "name": "Markdown lists and quotes",
      "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown", "markup.quote.markdown"],
      "settings": { "foreground": "#6c7a92" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "markup.inserted.diff"],
      "settings": { "foreground": "#a8c986" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "markup.deleted.diff"],
      "settings": { "foreground": "#e59aa8" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "markup.changed.diff"],
      "settings": { "foreground": "#e6cf7e" }
    },
    {
      "name": "Diff headers",
      "scope": ["meta.diff.header", "meta.diff.header.from-file", "meta.diff.header.to-file"],
      "settings": { "foreground": "#78bfc4" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal", "invalid.broken", "invalid.deprecated", "invalid.unimplemented"],
      "settings": { "foreground": "#f08a8a" }
    }
  ],
